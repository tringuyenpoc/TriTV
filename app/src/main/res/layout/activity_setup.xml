<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="64dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Nhập link playlist (.m3u / .m3u8)" android:textColor="@color/text"
        android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="15sp"
        android:text="Mẹo: dùng app Google TV trên điện thoại để gõ hoặc dán link nhanh hơn." />
    <EditText android:id="@+id/url" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:inputType="textUri" android:hint="http://..." android:textColor="@color/text"
        android:textColorHint="@color/muted" android:imeOptions="actionDone" android:singleLine="true" />
    <TextView android:id="@+id/save" style="@style/TopButton" android:layout_marginStart="0dp"
        android:layout_marginTop="24dp" android:text="Lưu và tải" />
</LinearLayout>
