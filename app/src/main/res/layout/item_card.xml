<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp" android:layout_height="140dp"
    android:layout_marginEnd="16dp" android:orientation="vertical"
    android:background="@drawable/card_bg" android:focusable="true" android:clickable="true"
    android:padding="8dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/logo" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitCenter" android:padding="6dp" />
        <TextView android:id="@+id/initials" android:layout_width="match_parent"
            android:layout_height="match_parent" android:gravity="center"
            android:textColor="@color/accent" android:textSize="34sp" android:textStyle="bold" />
    </FrameLayout>
    <TextView android:id="@+id/name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:textColor="@color/text" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="marquee" />
</LinearLayout>
